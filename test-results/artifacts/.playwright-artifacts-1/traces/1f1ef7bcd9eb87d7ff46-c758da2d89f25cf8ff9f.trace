k-word;\r\n}\r\n\r\n.reader-prose p {\r\n  margin-bottom: 1.5em;\r\n}\r\n\r\n.reader-prose h1,\r\n.reader-prose h2,\r\n.reader-prose h3,\r\n.reader-prose h4 {\r\n  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\r\n  font-weight: 700;\r\n  margin-top: 2em;\r\n  margin-bottom: 0.75em;\r\n  color: #111827;\r\n  line-height: 1.3;\r\n}\r\n\r\n.reader-prose h1 { font-size: 2em; }\r\n.reader-prose h2 { font-size: 1.5em; }\r\n.reader-prose h3 { font-size: 1.25em; }\r\n.reader-prose h4 { font-size: 1.1em; }\r\n\r\n.reader-prose a {\r\n  color: #4f46e5;\r\n  text-decoration: underline;\r\n  text-decoration-color: #c7d2fe;\r\n  text-underline-offset: 2px;\r\n  transition: all 0.2s;\r\n}\r\n\r\n.reader-prose a:hover {\r\n  color: #4338ca;\r\n  text-decoration-color: #4f46e5;\r\n}\r\n\r\n.reader-prose strong,\r\n.reader-prose b {\r\n  font-weight: 700;\r\n  color: #111827;\r\n}\r\n\r\n.reader-prose em,\r\n.reader-prose i {\r\n  font-style: italic;\r\n}\r\n\r\n.reader-prose blockquote {\r\n  border-left: 4px solid #e5e7eb;\r\n  padding-left: 1.5em;\r\n  margin: 2em 0;\r\n  color: #6b7280;\r\n  font-style: italic;\r\n}\r\n\r\n.reader-prose img {\r\n  max-width: 100%;\r\n  height: auto;\r\n  border-radius: 8px;\r\n  margin: 2em auto;\r\n  display: block;\r\n  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n.reader-prose figure {\r\n  margin: 2.5em 0;\r\n}\r\n\r\n.reader-prose figcaption {\r\n  text-align: center;\r\n  font-size: 0.875em;\r\n  color: #6b7280;\r\n  margin-top: 0.75em;\r\n  font-style: italic;\r\n}\r\n\r\n.reader-prose ul,\r\n.reader-prose ol {\r\n  margin: 1.5em 0;\r\n  padding-left: 2em;\r\n}\r\n\r\n.reader-prose ul {\r\n  list-style-type: disc;\r\n}\r\n\r\n.reader-prose ol {\r\n  list-style-type: decimal;\r\n}\r\n\r\n.reader-prose li {\r\n  margin-bottom: 0.5em;\r\n}\r\n\r\n.reader-prose li > ul,\r\n.reader-prose li > ol {\r\n  margin-top: 0.5em;\r\n  margin-bottom: 0.5em;\r\n}\r\n\r\n.reader-prose pre {\r\n  background: #f8f9fa;\r\n  border: 1px solid #e5e7eb;\r\n  border-radius: 8px;\r\n  padding: 1.25em;\r\n  overflow-x: auto;\r\n  font-size: 0.875em;\r\n  line-height: 1.6;\r\n  margin: 2em 0;\r\n}\r\n\r\n.reader-prose code {\r\n  font-family: 'JetBrains Mono', 'Menlo', 'Monaco', 'Courier New', monospace;\r\n  background: #f3f4f6;\r\n  padding: 0.2em 0.4em;\r\n  border-radius: 3px;\r\n  font-size: 0.9em;\r\n}\r\n\r\n.reader-prose pre code {\r\n  background: none;\r\n  padding: 0;\r\n  font-size: inherit;\r\n  border-radius: 0;\r\n}\r\n\r\n.reader-prose table {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n  margin: 1.5em 0;\r\n  font-size: 0.9em;\r\n}\r\n\r\n.reader-prose th,\r\n.reader-prose td {\r\n  border: 1px solid #e5e7eb;\r\n  padding: 0.75em;\r\n  text-align: left;\r\n}\r\n\r\n.reader-prose th {\r\n  background: #f9fafb;\r\n  font-weight: 600;\r\n}\r\n\r\n/* Nested divs from Readability output — ensure they don't break spacing */\r\n.reader-prose > div {\r\n  margin-bottom: 1.5em;\r\n}\r\n\r\n/* Handle empty paragraphs (often from article extraction) */\r\n.reader-prose p:empty {\r\n  display: none;\r\n}\r\n\r\n/* Ensure hr separators are styled */\r\n.reader-prose hr {\r\n  border: none;\r\n  border-top: 1px solid #e5e7eb;\r\n  margin: 2.5em 0;\r\n}\r\n\r\n/* Footer */\r\n.reader-footer {\r\n  margin-top: 3rem;\r\n  padding-top: 2rem;\r\n  border-top: 1px solid #e5e7eb;\r\n  text-align: center;\r\n}\r\n\r\n/* Responsive */\r\n@media (max-width: 640px) {\r\n  .reader-container {\r\n    padding: 1rem;\r\n  }\r\n\r\n  .reader-title {\r\n    font-size: 1.75rem;\r\n  }\r\n\r\n  .reader-prose {\r\n    font-size: 1rem;\r\n  }\r\n}\r\n\r\n/* Dark mode support */\r\n@media (prefers-color-scheme: dark) {\r\n  .reader-title {\r\n    color: #f3f4f6;\r\n  }\r\n\r\n  .reader-meta {\r\n    color: #9ca3af;\r\n  }\r\n\r\n  .reader-author {\r\n    color: #d1d5db;\r\n  }\r\n\r\n  .reader-header {\r\n    border-color: #374151;\r\n  }\r\n\r\n  .reader-prose {\r\n    color: #e5e7eb;\r\n  }\r\n