-card: #ffffff;\r\n  --workbench-card-soft: #fcfaf6;\r\n  --workbench-border: #d9d2c4;\r\n  --workbench-border-strong: #c7bead;\r\n  --workbench-text: #18150f;\r\n  --workbench-text-soft: #544b3f;\r\n  --workbench-text-muted: #82796a;\r\n  --workbench-blue: #2f80ff;\r\n  --workbench-blue-ink: #225fb8;\r\n  --workbench-blue-soft: rgba(47, 128, 255, 0.12);\r\n  --workbench-green: #1f9d67;\r\n  --workbench-red: #c34a3c;\r\n  --workbench-amber: #b77923;\r\n  --workbench-shadow-card: 0 8px 24px rgba(30, 26, 18, 0.08);\r\n  --workbench-shadow-node: 0 6px 16px rgba(30, 26, 18, 0.09);\r\n}\r\n\r\n@media (prefers-color-scheme: dark) {\r\n  :root {\r\n    --bg-base: #11100d;\r\n    --bg-subtle: #1b1914;\r\n    --bg-muted: #27231c;\r\n    --bg-0: #11100d;\r\n    --bg-1: #1b1914;\r\n\r\n    --surface: #1b1914;\r\n    --surface-raised: #22201a;\r\n    --surface-0: #1b1914;\r\n    --surface-1: #22201a;\r\n    --surface-50: #27231c;\r\n    --surface-100: #2f2a22;\r\n\r\n    --text-primary: #f5f0e7;\r\n    --text-secondary: #cbc2b0;\r\n    --text-tertiary: #9f9481;\r\n    --text-0: #f5f0e7;\r\n    --text-1: #cbc2b0;\r\n    --text-2: #9f9481;\r\n\r\n    --border-primary: #3a342a;\r\n    --border-secondary: #2b261e;\r\n    --stroke-0: #3a342a;\r\n    --stroke-1: #2b261e;\r\n\r\n    --interactive-primary: #8ab3ff;\r\n    --interactive-hover: #76a5fb;\r\n    --interactive-active: #5c93f7;\r\n\r\n    --accent-blue: #8ab3ff;\r\n    --accent-blue-subtle: rgba(138, 179, 255, 0.2);\r\n    --accent-300: #b3ccff;\r\n    --accent-400: #9dc0ff;\r\n    --accent-500: #8ab3ff;\r\n    --accent-600: #76a5fb;\r\n\r\n    --success: #4fcb80;\r\n    --success-subtle: rgba(79, 203, 128, 0.15);\r\n    --warning: #f6a24f;\r\n    --warning-subtle: rgba(246, 162, 79, 0.15);\r\n    --error: #f17a70;\r\n    --error-subtle: rgba(241, 122, 112, 0.15);\r\n\r\n    --ai-accent: #A78BFA;\r\n    --ai-accent-subtle: rgba(167, 139, 250, 0.12);\r\n    --bg-elevated: var(--surface-1);\r\n\r\n    --workbench-bg: #171410;\r\n    --workbench-canvas: #1d1914;\r\n    --workbench-panel: #201b15;\r\n    --workbench-card: #242018;\r\n    --workbench-card-soft: #2a251d;\r\n    --workbench-border: #3f382d;\r\n    --workbench-border-strong: #5a5242;\r\n    --workbench-text: #f4efe6;\r\n    --workbench-text-soft: #cec4b2;\r\n    --workbench-text-muted: #9f9481;\r\n    --workbench-blue: #8ab3ff;\r\n    --workbench-blue-ink: #b9d2ff;\r\n    --workbench-blue-soft: rgba(138, 179, 255, 0.16);\r\n    --workbench-green: #57c68b;\r\n    --workbench-red: #f18a7e;\r\n    --workbench-amber: #efb068;\r\n    --workbench-shadow-card: 0 10px 26px rgba(0, 0, 0, 0.32);\r\n    --workbench-shadow-node: 0 8px 20px rgba(0, 0, 0, 0.34);\r\n  }\r\n}\r\n\r\n* {\r\n  box-sizing: border-box;\r\n}\r\n\r\nhtml,\r\nbody,\r\n#root {\r\n  min-height: 100%;\r\n}\r\n\r\nbody {\r\n  margin: 0;\r\n  font-family: var(--font-body);\r\n  font-size: 14px;\r\n  line-height: 1.6;\r\n  color: var(--text-primary);\r\n  background-color: var(--bg-base);\r\n  background-image:\r\n    radial-gradient(140% 100% at 0% 0%, rgba(13, 110, 253, 0.12) 0%, transparent 52%),\r\n    radial-gradient(120% 120% at 100% 0%, rgba(182, 134, 44, 0.1) 0%, transparent 44%),\r\n    linear-gradient(180deg, #f8f6f1 0%, #f2eee5 100%);\r\n  -webkit-font-smoothing: antialiased;\r\n  -moz-osx-font-smoothing: grayscale;\r\n  font-feature-settings: 'cv02', 'cv03', 'cv04', 'cv11';\r\n}\r\n\r\nbody::before {\r\n  content: '';\r\n  position: fixed;\r\n  inset: 0;\r\n  pointer-events: none;\r\n  z-index: 0;\r\n  background:\r\n    repeating-linear-gradient(\r\n      90deg,\r\n      rgba(23, 20, 15, 0.015) 0,\r\n      rgba(23, 20, 15, 0.015) 1px,\r\n      transparent 1px,\r\n      transparent 3px\r\n    );\r\n  opacity: 0.32;\r\n}\r\n\r\n#root {\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n\r\nh1 {\r\n  font-family: var(--font-display);\r\n  font-size: clamp(1.95rem, 2.35vw, 2.65rem);\r\n  font-weight: 800;\r\n  line-height: 1.15;\r\n  letter-spacing: -0.03em;\r\n}\r\n\r\nh2 {\r\n  font-family: var(--font-display);\r\n  font-size: clamp(1.45rem, 1.75vw, 1.95rem);\r\n  font-weight: 700;\r\n  line-height: 1.24;\r\n  letter-spacing: -0.02em;\r\n}\r\n\r\nh3 {\r\n  font-family: var(--font-display);\r\n  font-size: 1.1rem;\r\n  font-weight: 700;\r\n  line-height: 1.35;\r\n}\r\n\r\nh4,\r\nh5 {\r\n  font-family: var(--font-body);\r\n}\r\n\r\np {\r\n  margin: 0;\r\n}\r\n\r\n::-moz-selection {\r\n  background: var(--accent-blue-subtle);\r\n  color: var(--text-primary);\r\n}\r\n\r\n::selection {\r\n  background: var(--accent-blue-subtle);\r\n  color: var(--text-primary);\r\n}\r\n\r\n::-webkit-scrollbar {\r\n  width: 6px;\r\n  height: 6px;\r\n}\r\n\r\n::-webkit-scrollbar-track {\r\n  background: transparent;\r\n}\r\n\r\n::-webkit-scrollbar-thumb {\r\n  background: var(--border-primary);\r\n  border-radius: 3px;\r\n}\r\n\r\n::-webkit-scrollbar-thumb:hover {\r\n  background: var(--text-tertiary);\r\n}\r\n\r\n.btn {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: var(--space-2);\r\n  padding: 0 var(--space-4);\r\n  height: 38px;\r\n  font-size: 14px;\r\n  font-weight: 600;\r\n  border-radius: var(--radius-md);\r\n  border: 1px solid var(--border-primary);\r\n  cursor: pointer;\r\n  transition: all 180ms cubic-bezier(0.2, 0.8, 0.2, 1);\r\n  white-space: nowrap;\r\n}\r\n\r\n.btn-primary {\r\n  background: linear-gradient(135deg, var(--interactive-primary) 0%, var(--interactive-hover) 100%);\r\n  color: white;\r\n  border-color: rgba(18, 31, 52, 0.7);\r\n  box-shadow: 0 6px 16px rgba(31, 58, 95, 0.24);\r\n}\r\n\r\n.btn-primary:hover:not(:disabled) {\r\n  transform: translateY(-1px);\r\n  box-shadow: 0 9px 20px rgba(31, 58, 95, 0.3);\r\n}\r\n\r\n.btn-primary:active:not(:disabled) {\r\n  transform: translateY(0);\r\n}\r\n\r\n.btn-primary:disabled {\r\n  opacity: 0.42;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.btn-secondary {\r\n  background: rgba(255, 255, 255, 0.78);\r\n  color: var(--text-primary);\r\n  border-color: var(--border-primary);\r\n}\r\n\r\n.btn-secondary:hover:not(:disabled) {\r\n  background: var(--surface-raised);\r\n  border-color: #cabfae;\r\n}\r\n\r\n.btn-ghost {\r\n  background: transparent;\r\n  color: var(--text-secondary);\r\n  border-color: transparent;\r\n}\r\n\r\n.btn-ghost:hover:not(:disabled) {\r\n  background: rgba(255, 255, 255, 0.6);\r\n  color: var(--text-primary);\r\n}\r\n\r\n.input {\r\n  width: 100%;\r\n  height: 40px;\r\n  padding: 0 var(--space-3);\r\n  font-size: 14px;\r\n  color: var(--text-primary);\r\n  background: rgba(255, 255, 255, 0.86);\r\n  border: 1px solid var(--border-primary);\r\n  border-radius: var(--radius-md);\r\n  transition: border-color 180ms ease, box-shadow 180ms ease, background 180ms ease;\r\n}\r\n\r\n.input:focus {\r\n  outline: none;\r\n  background: #fff;\r\n  border-color: rgba(13, 110, 253, 0.5);\r\n  box-shadow: var(--glow);\r\n}\r\n\r\n.input::-moz-placeholder {\r\n  color: var(--text-tertiary);\r\n}\r\n\r\n.input::placeholder {\r\n  color: var(--text-tertiary);\r\n}\r\n\r\n.textarea {\r\n  width: 100%;\r\n  padding: var(--space-3);\r\n  font-size: 14px;\r\n  line-height: 1.6;\r\n  color: var(--text-primary);\r\n  background: rgba(255, 255, 255, 0.86);\r\n  border: 1px solid var(--border-primary);\r\n  border-radius: var(--radius-md);\r\n  resize: vertical;\r\n  transition: border-color 180ms ease, box-shadow 180ms ease, background 180ms ease;\r\n}\r\n\r\n.textarea:focus {\r\n  outline: none;\r\n  background: #fff;\r\n  border-color: rgba(13, 110, 253, 0.5);\r\n  box-shadow: var(--glow);\r\n}\r\n\r\n.card {\r\n  background: var(--surface);\r\n  border: 1px solid var(--border-primary);\r\n  border-radius: var(--radius-lg);\r\n  padding: var(--space-6);\r\n  box-shadow: var(--shadow-sm);\r\n  backdrop-filter: blur(6px);\r\n  transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;\r\n}\r\n\r\n.card-hover:hover {\r\n  border-color: #c8bca9;\r\n  box-shadow: var(--shadow-md);\r\n  transform: translateY(-1px);\r\n}\r\n\r\n.glass-surface {\r\n  background: rgba(255, 255, 255, 0.88);\r\n  border: 1px solid var(--border-primary);\r\n  backdrop-filter: blur(10px);\r\n}\r\n\r\n.badge {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  height: 20px;\r\n  padding: 0 8px;\r\n  font-size: 10px;\r\n  font-weight: 700;\r\n  letter-spacing: 0.06em;\r\n  text-transform: uppercase;\r\n  border-radius: 999px;\r\n  border: 1px solid transparent;\r\n  line-height: 1;\r\n}\r\n\r\n.badge-fact {\r\n  background: #f3eee5;\r\n  color: #2a2318;\r\n  border-color: #d7cdbd;\r\n}\r\n\r\n.badge-view {\r\n  background: #eef3fb;\r\n  color: #486080;\r\n  border-color: #cfd9ea;\r\n}\r\n\r\n.badge-status {\r\n  background: #f4f0e8;\r\n  color: var(--text-secondary);\r\n  border-color: var(--border-primary);\r\n}\r\n\r\n.semantic-chip {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  height: 20px;\r\n  padding: 0 8px;\r\n  border-radius: 999px;\r\n  border: 1px solid transparent;\r\n  font-size: 10px;\r\n  font-weight: 700;\r\n  line-height: 1;\r\n}\r\n\r\n.semantic-chip-support {\r\n  color: var(--workbench-green);\r\n  background: rgba(31, 157, 103, 0.1);\r\n  border-color: rgba(31, 157, 103, 0.3);\r\n}\r\n\r\n.semantic-chip-refute {\r\n  color: var(--workbench-red);\r\n  background: rgba(195, 74, 60, 0.1);\r\n  border-color: rgba(195, 74, 60, 0.3);\r\n}\r\n\r\n.semantic-chip-neutral {\r\n  color: var(--workbench-text-muted);\r\n  background: rgba(130, 121, 106, 0.12);\r\n  border-color: rgba(130, 121, 106, 0.3);\r\n}\r\n\r\n.neuro-handle {\r\n  width: 10px;\r\n  height: 10px;\r\n  border-radius: 999px;\r\n  border: 2px solid var(--workbench-card);\r\n  background: var(--workbench-blue);\r\n  box-shadow: 0 0 0 1px rgba(47, 128, 255, 0.25);\r\n}\r\n\r\n.neuro-handle:hover {\r\n  transform: scale(1.08);\r\n}\r\n\r\n.workbench-tab-strip {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  padding: 4px;\r\n  border-radius: 12px;\r\n  background: var(--workbench-panel);\r\n  border: 1px solid var(--workbench-border);\r\n}\r\n\r\n.workbench-tab {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  height: 34px;\r\n  padding: 0 14px;\r\n  border-radius: 9px;\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  color: var(--workbench-text-muted);\r\n  transition: background-color 160ms ease, color 160ms ease, box-shadow 160ms ease;\r\n}\r\n\r\n.workbench-tab-active {\r\n  background: var(--workbench-card);\r\n  color: var(--workbench-text);\r\n  border: 1px solid var(--workbench-border);\r\n  box-shadow: 0 3px 10px rgba(30, 26, 18, 0.06);\r\n}\r\n\r\n@keyframes fadeIn {\r\n  from { opacity: 0; }\r\n  to { opacity: 1; }\r\n}\r\n\r\n@keyframes slideUp {\r\n  from { opacity: 0; transform: translateY(10px); }\r\n  to { opacity: 1; transform: translateY(0); }\r\n}\r\n\r\n.animate-fade-in {\r\n  animation: fadeIn 180ms ease-out;\r\n}\r\n\r\n.animate-slide-up {\r\n  animation: slideUp 180ms ease-out;\r\n}\r\n\r\n@keyframes shimmer {\r\n  0% { background-position: -200% 0; }\r\n  100% { background-position: 200% 0; }\r\n}\r\n\r\n/* ===== Board Node Animations (Spec §2.1) ===== */\r\n\r\n@keyframes nodeAppear {\r\n    from { transform: scale(0.8); opacity: 0; }\r\n    to   { transform: scale(1);   opacity: 1; }\r\n}\r\n\r\n@keyframes nodeReject {\r\n    0%   { transform: scale(1) translateY(0); opacity: 1; filter: blur(0px); }\r\n    40%  { transform: scale(0.95) translateY(4px); opacity: 0.7; filter: blur(0px); }\r\n    100% { transform: scale(0.85) translateY(16px); opacity: 0; filter: blur(2px); }\r\n}\r\n\r\n@keyframes nodePulse {\r\n    0%, 100% { box-shadow: 0 0 0 0 rgba(139, 92, 246, 0); }\r\n    50%      { box-shadow: 0 0 12px 4px rgba(139, 92, 246, 0.25); }\r\n}\r\n\r\n@keyframes commitFlash {\r\n    0%   { box-shadow: 0 0 0 0 rgba(24, 160, 106, 0.4); }\r\n    50%  { box-shadow: 0 0 16px 4px rgba(24, 160, 106, 0.25); }\r\n    100% { box-shadow: 0 0 0 0 rgba(24, 160, 106, 0); }\r\n}\r\n\r\n/* Utility classes for board animations */\r\n\r\n.node-entering {\r\n    animation: nodeAppear 200ms ease-out;\r\n}\r\n\r\n.node-rejecting {\r\n    animation: nodeReject 300ms cubic-bezier(0.4, 0, 0.7, 0.2) forwards;\r\n}\r\n\r\n.node-pulse {\r\n    animation: nodePulse 1.5s infinite;\r\n}\r\n\r\n.node-committing {\r\n    animation: commitFlash 500ms ease-out;\r\n}\r\n\r\n/* Draft node transition styles */\r\n\r\n.draft-node-container {\r\n    transition: border-color 150ms ease, opacity 150ms ease, background-color 150ms ease;\r\n}\r\n\r\n.draft-node-badge {\r\n    transition: opacity 200ms ease;\r\n}\r\n\r\n/* Dagre re-layout position transition (toggled programmatically) */\r\n\r\n.dagre-transitioning .react-flow__node {\r\n    transition: transform 300ms ease !important;\r\n}\r\n\r\n.skeleton {\r\n  background: linear-gradient(\r\n    90deg,\r\n    var(--bg-subtle) 25%,\r\n    var(--bg-muted) 50%,\r\n    var(--bg-subtle) 75%\r\n  );\r\n  background-size: 200% 100%;\r\n  animation: shimmer 1.5s infinite;\r\n  border-radius: var(--radius-md);\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  *,\r\n  *::before,\r\n  *::after {\r\n    animation-duration: 0.01ms !important;\r\n    animation-iteration-count: 1 !important;\r\n    transition-duration: 0.01ms !important;\r\n  }\r\n}\r\n\r\n:focus-visible {\r\n  outline: 2px solid var(--accent-blue);\r\n  outline-offset: 2px;\r\n}\r\n\r\n.card-readwise {\r\n  padding: var(--space-5);\r\n}\r\n\r\n.input-focus {\r\n  width: 100%;\r\n  height: 40px;\r\n  padding: 0 var(--space-3);\r\n  font-size: 14px;\r\n  color: var(--text-primary);\r\n  background: rgba(255, 255, 255, 0.86);\r\n  border: 1px solid var(--border-primary);\r\n  border-radius: var(--radius-md);\r\n  transition: border-color 180ms ease, box-shadow 180ms ease, background 180ms ease;\r\n}\r\n\r\n.input-focus:focus {\r\n  outline: none;\r\n  background: #fff;\r\n  border-color: rgba(13, 110, 253, 0.5);\r\n  box-shadow: var(--glow