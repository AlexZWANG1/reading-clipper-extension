{
  "name": "reading-cards-backend",
  "version": "2.0.0",
  "description": "Reading Clipper 后端服务 - 支持云端存储和多用户",
  "type": "module",
  "main": "src/server.mjs",
  "scripts": {
    "dev": "concurrently -n \"backend,sidecar\" -c \"blue,green\" \"node --watch src/server.mjs\" \"cd ../ingestion-sidecar && python run.py\"",
    "start": "concurrently -n \"backend,sidecar\" -c \"blue,green\" \"node src/server.mjs\" \"cd ../ingestion-sidecar && python run.py\"",
    "backend-only": "node src/server.mjs",
    "build": "echo 'No build step required for this backend service'",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "keywords": [
    "reading",
    "cards",
    "knowledge",
    "clipper"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fast-xml-parser": "^5.3.2",
    "multer": "^2.0.2",
    "openai": "^6.10.0",
    "rss-parser": "^3.13.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
