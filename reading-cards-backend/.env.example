# ========= Reading Cards Backend 环境变量配置 =========

# ========= AI API 配置（代理模式优先）=========

# 代理模式（推荐）：通过 CLI Proxy API Management Center
# 设置这两个变量后，所有 AI 请求将通过代理路由
AI_PROXY_ENDPOINT=http://localhost:8080/v1
AI_PROXY_API_KEY=your-proxy-api-key-here

# 直连模式（fallback）：直接调用 OpenAI/Anthropic API
# 仅在未设置代理时使用
OPENAI_API_KEY=sk-proj-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# 默认模型（可选）
OPENAI_MODEL=gpt-5.2

# ========= Supabase 配置 =========
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ========= 服务器配置 =========
PORT=3000

# ========= 使用说明 =========
#
# 代理模式（推荐）：
# 1. 部署 CLI Proxy API Management Center
# 2. 设置 AI_PROXY_ENDPOINT 和 AI_PROXY_API_KEY
# 3. 不需要设置 OPENAI_API_KEY 或 ANTHROPIC_API_KEY
# 4. 所有 AI 请求自动通过代理路由
#
# 直连模式：
# 1. 不设置 AI_PROXY_ENDPOINT 和 AI_PROXY_API_KEY（或留空）
# 2. 设置 OPENAI_API_KEY 和/或 ANTHROPIC_API_KEY
# 3. AI 请求直接调用官方 API
#
# 注意：vectorStoresV2.mjs 仍然直连 OpenAI（需要 OPENAI_API_KEY）

# ========= 安全配置 =========
API_KEY_ENCRYPTION_SECRET=  # 32 bytes hex string for AES-256-GCM encryption of user API keys (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")

