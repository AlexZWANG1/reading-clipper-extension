# Postgres (Supabase direct connection string)
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# Embedding provider: openai / ollama / voyage / google
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# OpenAI API key (for embedding when EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=sk-xxx
# Optional: proxy endpoint for embedding calls
# OPENAI_BASE_URL=http://localhost:8080/v1

# Internal API key (Node.js backend uses this to call sidecar)
SIDECAR_API_KEY=your-internal-secret

# Server binding
HOST=127.0.0.1
PORT=8100
