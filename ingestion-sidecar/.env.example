# Supabase REST API (required)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Local Ollama embeddings (OpenAI-compatible API)
EMBEDDINGS_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDINGS_MODEL=nomic-embed-text
EMBEDDINGS_API_KEY=ollama
EMBEDDINGS_DIMENSIONS=768

# Content extraction engines
URL_ENGINE=jina
DOC_ENGINE=docling

# Internal API key (Node.js backend uses this to call sidecar)
SIDECAR_API_KEY=your-internal-secret

# Server binding
HOST=127.0.0.1
PORT=8100
